# ============================================================
# Docker Compose — local dev environment
# ============================================================
# 1. Copy this file:  cp .env.docker.example .env.docker
# 2. Replace every value with a strong random secret:
#      openssl rand -base64 32
# 3. NEVER commit .env.docker — it is in .gitignore
# ============================================================

# Postgres superuser (used only by Docker container init)
POSTGRES_DB=replace_with_your_db_name
POSTGRES_USER=replace_with_your_pg_admin_user
POSTGRES_PASSWORD=replace_with_strong_password

# Host ports (change if these conflict with local services)
POSTGRES_PORT=5432
REDIS_PORT=6379
MONOLITH_PORT=3000

# Per-service DB passwords (each service gets its own DB user)
# Generate each with: openssl rand -base64 32
MONOLITH_DB_PASSWORD=replace_with_strong_password
AUTH_DB_PASSWORD=replace_with_strong_password
USERS_DB_PASSWORD=replace_with_strong_password
SUBJECTS_DB_PASSWORD=replace_with_strong_password
PRODUCTS_DB_PASSWORD=replace_with_strong_password
AI_WRITER_DB_PASSWORD=replace_with_strong_password
CHANNELS_DB_PASSWORD=replace_with_strong_password
SCHEDULER_DB_PASSWORD=replace_with_strong_password
BROADCASTER_DB_PASSWORD=replace_with_strong_password
GATEWAY_DB_PASSWORD=replace_with_strong_password
