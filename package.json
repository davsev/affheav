{
  "name": "affiliate-heaven",
  "version": "1.0.0",
  "description": "Automated affiliate marketing dashboard - WhatsApp & Facebook product broadcaster",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r vitest run",
    "lint": "pnpm -r eslint .",
    "compose": "docker compose -f docker-compose.yml -f docker-compose.override.yml up"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "googleapis": "^140.0.1",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "openai": "^4.52.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "4.1.5"
  }
}
