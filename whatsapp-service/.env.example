PORT=3001

# Secret key — include in X-API-Key header on every /send and /groups request
WHATSAPP_API_KEY=changeme

# Session storage path (Railway: /data/wwebjs_auth via volume; local: leave unset)
# WHATSAPP_DATA_PATH=/data/wwebjs_auth

# Set automatically by Puppeteer image; override only if using a custom Chrome path
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Pin a specific WhatsApp Web build if you find one that avoids the current
# getChats()/getState() "r: r" bug (see server.js) -- unset means track live,
# which is what's affected right now since there's no confirmed good build yet.
# Browse builds at https://github.com/wppconnect-team/wa-version/tree/main/html
# WA_VERSION_HTML_URL=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/<version>.html
