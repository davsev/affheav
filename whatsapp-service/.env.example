PORT=3001

# Secret key — include in X-API-Key header on every /send and /groups request
WHATSAPP_API_KEY=changeme

# Session storage path (Railway: /data/wwebjs_auth via volume; local: leave unset)
# WHATSAPP_DATA_PATH=/data/wwebjs_auth

# Set automatically by Puppeteer image; override only if using a custom Chrome path
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Pinned WhatsApp Web build (works around an unpatched whatsapp-web.js/WA Web
# incompatibility -- see server.js). Override if the default pin breaks too,
# or to update it once a newer known-good build is confirmed. Browse builds at
# https://github.com/wppconnect-team/wa-version/tree/main/html
# WA_VERSION_HTML_URL=https://raw.githubusercontent.com/wppconnect-team/wa-version/main/html/2.3000.1040481160-alpha.html
